{
  "name": "sso-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "SSO provider",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @sso/db db:migrate && pnpm --filter @sso/db-local db:migrate",
    "db:migrate:deploy": "pnpm --filter @sso/db db:migrate:deploy && pnpm --filter @sso/db-local db:migrate:deploy",
    "db:seed": "pnpm --filter @sso/db db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
