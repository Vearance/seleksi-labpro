# ─────────────────────────────────────────────────────────────────────────────
# SSO Platform — environment configuration reference
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit secrets. Every variable consumed by the platform is documented
# here. Values shown are safe development defaults.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development

# --- PostgreSQL: primary (Auth Provider / control panel) ---
POSTGRES_PRIMARY_HOST=localhost
POSTGRES_PRIMARY_PORT=5432
POSTGRES_PRIMARY_USER=sso
POSTGRES_PRIMARY_PASSWORD=change-me
POSTGRES_PRIMARY_DB=sso_primary
# URL used by @sso/db (migrations, seed, PrismaClient at runtime)
DATABASE_URL=postgresql://sso:change-me@localhost:5432/sso_primary

# --- PostgreSQL: local (shared by App A & App B) ---
POSTGRES_LOCAL_HOST=localhost
POSTGRES_LOCAL_PORT=5433
POSTGRES_LOCAL_USER=sso
POSTGRES_LOCAL_PASSWORD=change-me
POSTGRES_LOCAL_DB=sso_local
# URL used by @sso/db-local (migrations, seed, PrismaClient at runtime)
DATABASE_URL_LOCAL=postgresql://sso:change-me@localhost:5433/sso_local

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=sso
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://sso:change-me@localhost:5672/

# --- Auth Server ---
AUTH_SERVER_PORT=3000
# Browser-facing base URL (outside the compose network)
AUTH_SERVER_PUBLIC_URL=http://localhost:3000
# Service-to-service base URL (inside the compose network)
AUTH_SERVER_INTERNAL_URL=http://auth-server:3000
AUTH_SERVER_COOKIE_NAME=auth_sid
AUTH_SERVER_COOKIE_SECRET=change-me-cookie-signing-secret
AUTH_SERVER_SESSION_TTL_MINUTES=480

# --- Control Panel ---
CONTROL_PANEL_PORT=3001
CONTROL_PANEL_PUBLIC_URL=http://localhost:3001
CONTROL_PANEL_INTERNAL_URL=http://control-panel:3001

# --- App A ---
APP_A_PORT=4001
APP_A_PUBLIC_URL=http://localhost:4001
APP_A_INTERNAL_URL=http://app-a:4001
APP_A_CLIENT_ID=app-a-client
APP_A_CLIENT_SECRET=change-me-app-a-secret

# --- App B ---
APP_B_PORT=4002
APP_B_PUBLIC_URL=http://localhost:4002
APP_B_INTERNAL_URL=http://app-b:4002
APP_B_CLIENT_ID=app-b-client
APP_B_CLIENT_SECRET=change-me-app-b-secret

# --- Internal service-to-service auth (HMAC on /internal/*) ---
INTERNAL_HMAC_SECRET=change-me-internal-hmac-secret
INTERNAL_HMAC_TTL_SECONDS=300

# --- Idempotent seed (dev credentials — override in .env) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_DEMO_PASSWORD=change-me-demo-password
