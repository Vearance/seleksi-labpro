# SSO Platform — environment configuration reference
#
# Copy this file to `.env` and fill in real values.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL: primary (Auth Provider / control panel) ---
POSTGRES_PRIMARY_HOST=localhost
POSTGRES_PRIMARY_PORT=5434
POSTGRES_PRIMARY_USER=sso
POSTGRES_PRIMARY_PASSWORD=password
POSTGRES_PRIMARY_DB=sso_primary
# URL used by @sso/db
DATABASE_URL=postgresql://sso:password@localhost:5434/sso_primary

# --- PostgreSQL: local (shared by App A & App B) ---
POSTGRES_LOCAL_HOST=localhost
POSTGRES_LOCAL_PORT=5433
POSTGRES_LOCAL_USER=sso
POSTGRES_LOCAL_PASSWORD=password
POSTGRES_LOCAL_DB=sso_local
# URL used by @sso/db-local
DATABASE_URL_LOCAL=postgresql://sso:password@localhost:5433/sso_local

# --- RabbitMQ ---
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=sso
RABBITMQ_PASSWORD=password
RABBITMQ_URL=amqp://sso:password@localhost:5672/

# --- Sync Worker ---
# Port for the worker's liveness/readiness probe server
SYNC_WORKER_HEALTH_PORT=3002

# --- Auth Server ---
AUTH_SERVER_HOST=0.0.0.0
AUTH_SERVER_PORT=3000
# Base URL 
AUTH_SERVER_PUBLIC_URL=http://localhost:3000
# Service-to-service base URL (inside the compose network)
AUTH_SERVER_INTERNAL_URL=http://auth-server:3000
AUTH_SERVER_COOKIE_NAME=auth_sid
AUTH_SERVER_COOKIE_SECRET=cookie-signing-secret
AUTH_SERVER_SESSION_TTL_MINUTES=480

# --- Control Panel ---
CONTROL_PANEL_PORT=3001
CONTROL_PANEL_PUBLIC_URL=http://localhost:3001
CONTROL_PANEL_INTERNAL_URL=http://control-panel:3001

# --- App A ---
APP_A_PORT=4001
APP_A_PUBLIC_URL=http://localhost:4001
APP_A_INTERNAL_URL=http://app-a:4001
APP_A_CLIENT_ID=app-a-client
APP_A_CLIENT_SECRET=app-a-secret

# --- App B ---
APP_B_PORT=4002
APP_B_PUBLIC_URL=http://localhost:4002
APP_B_INTERNAL_URL=http://app-b:4002
APP_B_CLIENT_ID=app-b-client
APP_B_CLIENT_SECRET=app-b-secret

# --- Internal service-to-service auth (HMAC on /internal/*) ---
INTERNAL_HMAC_SECRET=internal-hmac-secret
INTERNAL_HMAC_TTL_SECONDS=300

# --- Credential for seeding  ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-password
SEED_DEMO_PASSWORD=demo-password
