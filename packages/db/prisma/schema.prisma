// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AppStatus {
  ACTIVE
  INACTIVE
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AccessDecision {
  ALLOW
  DENY
}

enum EventType {
  SessionRevoked
  PasswordChanged
  AccessPolicyChanged
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYING
  FAILED
}

// Users & Groups

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  email         String     @unique
  passwordHash  String     @map("password_hash")
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  groups           UserGroup[]
  sessions         SsoSession[]
  authCodes        AuthorizationCode[]
  accessTokens     AccessToken[]
  auditLogsAsActor  AuditLog[]  @relation("AuditActor")
  auditLogsAsTarget AuditLog[]  @relation("AuditTarget")
  events            Event[]

  @@map("users")
}

model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  users  UserGroup[]
  policy ApplicationGroupPolicy[]

  @@map("groups")
}

model UserGroup {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])  // one user could have more than one group
  @@map("user_groups")
}

//  Applications & Policies 

model Application {
  id                    String    @id @default(uuid()) @db.Uuid
  clientId              String    @unique @map("client_id")
  name                  String
  clientSecretHash      String    @map("client_secret_hash")
  launchUrl             String?   @map("launch_url")
  logoutNotificationUrl String    @map("logout_notification_url")
  status                AppStatus @default(ACTIVE)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  redirectUris ApplicationRedirectUri[]
  policies     ApplicationGroupPolicy[]
  authCodes    AuthorizationCode[]
  accessTokens AccessToken[]
  auditLogs    AuditLog[]
  events       Event[]
  deliveries   EventDelivery[]

  @@map("applications")
}

model ApplicationRedirectUri {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  uri           String
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, uri])
  @@map("application_redirect_uris")
}

model ApplicationGroupPolicy {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  groupId       String         @map("group_id") @db.Uuid
  access        AccessDecision @default(ALLOW)
  createdAt     DateTime       @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([applicationId, groupId, access])
  @@map("application_group_policies")
}

// Sessions & Tokens

model SsoSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  sessionTokenHash String        @unique @map("session_token_hash")
  status           SessionStatus @default(ACTIVE)
  userAgent        String?       @map("user_agent")
  ipAddress        String?       @map("ip_address")
  createdAt        DateTime      @default(now()) @map("created_at")
  expiresAt        DateTime      @map("expires_at")
  lastActivityAt   DateTime?     @map("last_activity_at")
  revokedAt        DateTime?     @map("revoked_at")
  revokeReason     String?       @map("revoke_reason")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  authCodes   AuthorizationCode[]
  accessTokens AccessToken[]
  auditLogs   AuditLog[]
  events      Event[]

  @@map("sso_sessions")
}

model AuthorizationCode {
  id                  String    @id @default(uuid()) @db.Uuid
  codeHash            String    @unique @map("code_hash")
  applicationId       String    @map("application_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  ssoSessionId        String    @map("sso_session_id") @db.Uuid
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  redirectUri         String    @map("redirect_uri")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     SsoSession  @relation(fields: [ssoSessionId], references: [id], onDelete: Cascade)

  @@map("authorization_codes")
}

model AccessToken {
  id             String      @id @default(uuid()) @db.Uuid
  tokenHash      String      @unique @map("token_hash")
  applicationId  String      @map("application_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  ssoSessionId   String      @map("sso_session_id") @db.Uuid
  scope          String?
  status         TokenStatus @default(ACTIVE)
  issuedAt       DateTime    @default(now()) @map("issued_at")
  expiresAt      DateTime    @map("expires_at")
  revokedAt      DateTime?   @map("revoked_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     SsoSession  @relation(fields: [ssoSessionId], references: [id], onDelete: Cascade)

  @@map("access_tokens")
}

// Audit

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  eventType     String   @map("event_type")
  actorId       String?  @map("actor_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  result        String   @map("result")
  metadata      Json?    @db.JsonB
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  actor       User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser  User?        @relation("AuditTarget", fields: [userId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  session     SsoSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// Event Outbox

model Event {
  id               String       @id @default(uuid()) @db.Uuid
  eventType        EventType    @map("event_type")
  userId           String       @map("user_id") @db.Uuid
  centralSessionId String?      @map("central_session_id") @db.Uuid
  applicationId    String?      @map("application_id") @db.Uuid
  payload          Json         @db.JsonB
  status           OutboxStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at")
  publishedAt      DateTime?    @map("published_at")

  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  centralSession SsoSession?    @relation(fields: [centralSessionId], references: [id], onDelete: SetNull)
  application    Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  deliveries     EventDelivery[]

  @@map("events")
}

model EventDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  applicationId  String         @map("application_id") @db.Uuid
  status         DeliveryStatus @default(PENDING)
  attemptCount   Int            @default(0) @map("attempt_count")
  lastAttemptAt  DateTime?      @map("last_attempt_at")
  nextRetryAt    DateTime?      @map("next_retry_at")
  processedAt    DateTime?      @map("processed_at")
  lastError      String?        @map("last_error")

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([eventId, applicationId])
  @@map("event_deliveries")
}
