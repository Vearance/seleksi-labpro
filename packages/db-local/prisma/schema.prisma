generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum LocalSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// Local Sessions

model LocalSession {
  id               String             @id @default(uuid()) @db.Uuid
  sessionTokenHash String             @unique @map("session_token_hash")
  externalUserId   String             @map("external_user_id") @db.Uuid
  centralSessionId String             @map("central_session_id") @db.Uuid
  applicationId    String             @map("application_id")
  status           LocalSessionStatus @default(ACTIVE)
  createdAt        DateTime           @default(now()) @map("created_at")
  expiresAt        DateTime           @map("expires_at")
  lastActivityAt   DateTime?          @map("last_activity_at")
  revokedAt        DateTime?          @map("revoked_at")
  revokeReason     String?            @map("revoke_reason")

  @@map("local_sessions")
}

// Profile Cache

model ProfileCache {
  externalUserId String   @id @map("external_user_id") @db.Uuid
  name           String
  email          String
  groups         Json?    @db.JsonB
  syncedAt       DateTime @map("synced_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("profile_cache")
}

// ── Processed Events (idempotency) ───────────────────────────────────

model ProcessedEvent {
  applicationId String   @map("application_id")
  eventId       String   @map("event_id") @db.Uuid
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at")
  result        String   @map("result")

  @@id([applicationId, eventId])
  @@map("processed_events")
}
